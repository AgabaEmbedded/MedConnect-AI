{
  "blockchain_enabled": true,
  "blockchain_network_selected": "sepolia",
  "daemon_endpoint": "0.0.0.0:10001",
  "daemon_group_name": "default_group",
  "ipfs_endpoint": "https://ipfs.singularitynet.io:443",
  "organization_id": "YOUR_ORG_ID",
  "service_id": "YOUR_SERVICE_ID",
  "service_endpoint": "http://localhost:50052",
  "metering_enabled": "false",
  "metering_endpoint": "https://marketplace-mt-v2.singularitynet.io",
  "ethereum_json_rpc_http_endpoint": "https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY",
  "ethereum_json_rpc_ws_endpoint": "wss://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY",
  "payment_channel_storage_type": "etcd",
  "payment_channel_cert_path": "/var/lib/etcd/cfssl/client.pem",
  "payment_channel_ca_path": "/var/lib/etcd/cfssl/ca.pem",
  "payment_channel_key_path": "/var/lib/etcd/cfssl/client-key.pem",
  "payment_channel_storage_client": {
    "connection_timeout": "10s",
    "request_timeout": "5s",
    "endpoints": ["https://YOUR_ETCD_HOST:2379"],
    "retry_times": 3,
    "retry_interval": "5s",
    "tls": {
      "cert": "/var/lib/etcd/cfssl/client.pem",
      "key": "/var/lib/etcd/cfssl/client-key.pem",
      "cacert": "/var/lib/etcd/cfssl/ca.pem"
    }
  },
  "ssl_cert": "/etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem",
  "ssl_key": "/etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem",
  "log": { "level": "debug", "output": { "type": ["stdout", "file"] } },
  "private_key_for_free_calls": "REPLACE_WITH_YOUR_KEY",
  "private_key_for_metering": "REPLACE_WITH_YOUR_KEY",
  "free_calls_per_address": {}
}
