# MedConnect-AI – required env vars (get values from service provider / instructor)
# Copy to .env and fill in.

# Required: Google Gemini API key (for primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud project ID (for Translation API)
GOOGLE_PROJECT_ID=your_google_cloud_project_id

# Path to Google Cloud service account JSON key (the "special key" from provider).
# Enables Cloud Translation API and other GCP APIs. Place medconnect-secrete.json
# in the project (or elsewhere) and set this to its absolute path.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/medconnect-secrete.json

# RunPod endpoint for the fine-tuned medical LLM (Mistral)
RUNPOD_BASE_URL=https://your-runpod-endpoint.proxy.runpod.net/v1

# Optional: override doctor list API (default: https://medconnect-api-xrmi.onrender.com/api/agents)
# USERS_ENDPOINT=https://medconnect-api-xrmi.onrender.com/api/agents

# Optional: Spitch API key (for voice input/output). If unset, server still runs; audio is skipped.
# SPITCH_API_KEY=your_spitch_api_key

# (GOOGLE_APPLICATION_CREDENTIALS above is the main way to supply the service account key for Translation API.)
